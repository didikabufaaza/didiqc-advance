{
  "name": "didiqc",
  "version": "9.12.0",
  "private": true,
  "description": "Sistem QC Laboratorium - InsForge + GitHub + Vercel auto-deploy",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "migrate:insforge": "bun run migrate-from-json.ts",
    "deploy:setup": "bash auto-deploy/scripts/deploy-all.sh",
    "deploy:insforge": "bash auto-deploy/scripts/setup-insforge-cli.sh",
    "deploy:vercel": "bash auto-deploy/scripts/auto-deploy-vercel.sh"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
