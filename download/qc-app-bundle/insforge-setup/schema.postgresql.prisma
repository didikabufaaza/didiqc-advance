  leukosit    String?
  trombosit   String?
  kesan       String?  @db.Text
  saran       String?  @db.Text
  imageURL    String?
  imageURL2   String?
  imageURL3   String?
  ownerUsername String
  createdDate DateTime @default(now())

  @@index([ownerUsername])
  @@index([noRM])
  @@map("imghemato")
}

