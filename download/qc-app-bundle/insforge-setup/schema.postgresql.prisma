// ============================================================
// didiQCsys v9.12 — Prisma Schema for PostgreSQL (InsForge)
// ============================================================
// Schema ini DIOPTIMALKAN untuk PostgreSQL di InsForge.
// Perbedaan dari versi SQLite:
//   1. provider = "postgresql" (bukan sqlite)
//   2. Field teks panjang (catatan, diagnosis, makroskopis) pakai @db.Text
//   3. Index tambahan untuk performa query di PostgreSQL
//   4. Dukungan native Boolean & DateTime (PostgreSQL punya tipe asli)
//
// CARA PAKAI:
//   1. Ganti file prisma/schema.prisma dengan file ini
//   2. Set DATABASE_URL di .env dengan connection string InsForge Anda
//   3. Jalankan: bunx prisma generate && bunx prisma db push
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Uncomment baris below jika InsForge memberikan direct connection URL terpisah
  // directUrl = env("DIRECT_URL")
}

// ============================================================
// 1. USERS
// ============================================================
model Users {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password      String
  fullName      String
  role          String   @default("user") // superadmin | user
  email         String?
  status        String   @default("active") // active | pending | rejected
  otp           String?
  otpExpiry     DateTime?
  expiryDate    DateTime?
  approvedBy    String?
  approvedDate  DateTime?
  createdDate   DateTime @default(now())
  lastLogin     DateTime?
  imgAnalAccess Boolean  @default(false)

  @@index([status])
  @@index([role])
  @@map("users")
}

// ============================================================
// 2. PARAMETERS
// ============================================================
model Parameters {
  id           String   @id // PAR_<ts>_<rand>
  parameter    String
  ownerUsername String
  createdDate  DateTime @default(now())
  createdBy    String
  bidang       String

  @@index([ownerUsername])
  @@index([bidang])
  @@map("parameters")
}

// ============================================================
// 3. LOTQC
// ============================================================
model LotQC {
  id            String  @id // LOT_<ts>_<rand>
  paramID       String
  noLot         String
  namaAlat      String?
  methode       String?
  satuan        String?
  expiredDate   String? // YYYY-MM-DD
  sumber        String  @default("Manufaktur")
  meanL1        Float?
  sdL1          Float?
  targetL1      Float?
  meanL2        Float?
  sdL2          Float?
  targetL2      Float?
  meanL3        Float?
  sdL3          Float?
  targetL3      Float?
  tea           Float?
  biasPct       Float?
  ownerUsername String

  @@index([paramID])
  @@index([ownerUsername])
  @@index([noLot])
  @@map("lotqc")
}

// ============================================================
// 4. INPUTQC
// ============================================================
model InputQC {
  id              String   @id // QC_<ts>_<rand>
  paramID         String
  lotID           String
  parameter       String
  noLot           String
  namaAlat        String?
  tanggal         String   // YYYY-MM-DD
  level1          Float?
  level2          Float?
  level3          Float?
  inputBy         String
  inputDate       DateTime @default(now())
  validated       Boolean  @default(false)
  validatedBy     String?
  validatedDate   DateTime?
  catatanValidasi String?  @db.Text
  ownerUsername   String

  @@index([paramID, lotID, tanggal])
  @@index([ownerUsername])
  @@index([tanggal])
  @@index([validated])
  @@map("inputqc")
}

// ============================================================
// 5. HISTORIQC
// ============================================================
model HistoriQC {
  id            String   @id // HQC_<ts>_<rand>
  qcid          String?
  paramID       String
  lotID         String?
  parameter     String
  noLot         String?
  namaAlat      String?
  tanggal       String?
  level1        Float?
  level2        Float?
  level3        Float?
  inputBy       String?
  deletedBy     String?
  deletedDate   DateTime @default(now())
  ownerUsername String
  actionType    String
  changeDetail  String?  @db.Text

  @@index([paramID])
  @@index([ownerUsername])
  @@index([deletedDate])
  @@map("historiqc")
}

// ============================================================
// 6. CALCULATEDSTATS
// ============================================================
model CalculatedStats {
  id           String   @id // STAT_<ts>_<rand>
  paramID      String
  lotID        String
  level        Int
  calcMean     Float?
  calcSD       Float?
  calcCV       Float?
  n            Int      @default(0)
  startDate    String?
  endDate      String?
  ownerUsername String

  @@index([paramID, lotID, level])
  @@index([ownerUsername])
  @@map("calculatedstats")
}

// ============================================================
// 7. BIASPME
// ============================================================
model BiasPME {
  id            String   @id // PME_<ts>_<rand>
  paramID       String
  lotID         String
  namaAlat      String?
  methode       String?
  satuan        String?
  siklus        String?
  tahun         String?
  hasilL1       Float?
  hasilL2       Float?
  hasilL3       Float?
  meanPesertaL1 Float?
  meanPesertaL2 Float?
  meanPesertaL3 Float?
  tea           Float?
  cvL1          Float?
  cvL2          Float?
  cvL3          Float?
  cvStartDate   String?
  cvEndDate     String?
  ownerUsername String

  @@index([paramID, lotID])
  @@index([ownerUsername])
  @@map("biaspme")
}

// ============================================================
// 8. DAFERTEA
// ============================================================
model DaftarTEa {
  id           String   @id // TEA_<ts>_<rand>
  paramID      String?
  parameter    String
  nilaiTEa     Float?
  referensi    String?
  ownerUsername String

  @@index([paramID])
  @@index([parameter])
  @@map("daftartea")
}

// ============================================================
// 9. SIGMACVOPT
// ============================================================
model SigmaCVOpt {
  id           String   @id // CVOPT_<ts>_<rand>
  paramID      String
  lotID        String
  namaAlat     String?
  startDate    String?
  endDate      String?
  avgSigma     Float?
  avgSigmaL12  Float?
  tea          Float?
  nqc          Int      @default(0)
  catatan      String?  @db.Text
  ownerUsername String
  siklusPME    String?
  tahunSiklus  String?
  biasPME1     Float?
  biasPME2     Float?
  biasPME3     Float?

  @@index([paramID, lotID])
  @@index([ownerUsername])
  @@map("sigmacvopt")
}

// ============================================================
// 10. LAPORANCATATAN
// ============================================================
model LaporanCatatan {
  id           String   @id
  filterKey    String
  bulanTahun   String?
  paramID      String?
  lotID        String?
  namaAlat     String?
  catatan      String?  @db.Text
  ownerUsername String

  @@index([filterKey])
  @@index([ownerUsername])
  @@index([paramID, lotID])
  @@map("laporancatatan")
}

// ============================================================
// 11. TABULASICATATAN
// ============================================================
model TabulasiCatatan {
  periodKey    String   @id
  catatan      String?  @db.Text
  by           String?
  createdDate  DateTime @default(now())

  @@map("tabulasicatatan")
}

// ============================================================
// 12. KOPSURAT
// ============================================================
model KopSurat {
  id           Int      @id @default(autoincrement())
  key          String
  value        String?  @db.Text
  ownerUsername String

  @@unique([key, ownerUsername])
  @@map("kopsurat")
}

// ============================================================
// 13. SETTINGS
// ============================================================
model Settings {
  key   String @id
  value String? @db.Text

  @@map("settings")
}

// ============================================================
// 14. LOGACTIVITY
// ============================================================
model LogActivity {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  username  String
  action    String
  detail    String?  @db.Text

  @@index([timestamp])
  @@index([username])
  @@map("logactivity")
}

// ============================================================
// 15. CATATANDOKTER
// ============================================================
model CatatanDokter {
  id           String   @id
  filterKey    String
  bidang       String?
  paramID      String?
  lotID        String?
  catatan      String?  @db.Text
  ownerUsername String
  createdDate  DateTime @default(now())

  @@index([filterKey])
  @@index([ownerUsername])
  @@map("catatandokter")
}

// ============================================================
// 16. USERPASSWORDS
// ============================================================
model UserPasswords {
  id            Int      @id @default(autoincrement())
  username      String
  password      String
  nama          String?
  createdBy     String?
  createdDate   DateTime @default(now())
  note          String?
  loginUsername String?
  status        String   @default("active")

  @@index([username])
  @@index([loginUsername])
  @@map("userpasswords")
}

// ============================================================
