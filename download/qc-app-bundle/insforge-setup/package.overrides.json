{
  "name": "didiQCsys",
  "version": "9.12.0",
  "description": "Sistem QC Laboratorium dengan Next.js 16 + Prisma + InsForge (PostgreSQL)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "migrate:insforge": "bun run migrate-from-json.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
